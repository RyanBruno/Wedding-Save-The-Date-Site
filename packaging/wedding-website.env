# Configuration for wedding-website-api.service.
#
# systemd reads this file with EnvironmentFile= just before starting the
# service, and every setting here overrides the matching Environment= default
# in the unit. The binary itself only ever reads environment variables; it does
# not know this file exists. Nothing is sourced by a shell, so:
#
#   KEY=value          no `export`, no $VAR expansion, no command substitution
#   #                  comments start the line
#   KEY=with spaces    quotes are optional, but a value containing a backslash
#                      or a quote needs single quotes around it: systemd applies
#                      shell escape rules to an unquoted value
#
# Edit, then restart:  sudo systemctl restart wedding-website-api.service
#
# pacman treats this as a config file: your edits survive upgrades, and a
# changed template arrives beside it as .pacnew.
#
# It is readable only by root because of ADMIN_PASSWORD. Keep it that way.

# The admin dashboard's password, at https://<this host>/api/admin.
# Empty or unset means the dashboard answers 503 — that is the "Admin dashboard
# is not configured" page. Set it to something long; it is the only thing
# between the internet and the entire guest list.
ADMIN_PASSWORD=

# Send the admin session cookie without Secure, so the dashboard works over
# plain HTTP. Local previews only — never on a public host.
#ADMIN_COOKIE_INSECURE=false

# Browsers may post the RSVP form from these origins, comma separated. Leave it
# unset while the form reaches the API on the same origin as the page — nginx
# proxies /api/, and a CDN in front of it forwards the same prefix to the same
# hostname — since that is not a cross-origin request at all. Set it if the
# form ever calls this host directly:
#RSVP_ALLOWED_ORIGINS=https://cameronandryan.com,https://www.cameronandryan.com

# The replies. The unit's StateDirectory= creates /var/lib/wedding-website and
# the service can write nowhere else, so a path outside it needs the unit
# changed too.
#DATABASE_URL=sqlite:/var/lib/wedding-website/database.db

# Where the API listens. nginx proxies /api/ here, so localhost is deliberate:
# binding a public address would put the service in front of the internet
# without TLS.
#LEPTOS_SITE_ADDR=127.0.0.1:3000

# info, debug, or a per-module filter like info,wedding_website=debug.
#RUST_LOG=info
