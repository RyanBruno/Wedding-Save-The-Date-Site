post_install() {
    cat <<'MSG'
==> wedding-website installed.

    Three steps are still needed on a fresh machine:

      1. Generate the TLS certificate (self-signed for now):
           sudo /usr/share/doc/wedding-website/generate-self-signed-cert.sh

      2. Let nginx read conf.d by adding this inside the http block of
         /etc/nginx/nginx.conf, and comment out its default server block:
           include conf.d/*.conf;

      3. Start nginx:
           sudo systemctl enable --now nginx.service
MSG
}

pre_upgrade() {
    migration=/run/wedding-website-tls.conf
    config=/etc/nginx/conf.d/wedding-website.conf

    rm -f "$migration"

    # Older builds kept certificate paths in the main nginx configuration.
    # Save exactly those directives before pacman replaces that file. The new
    # package preserves them in a dedicated backup= file.
    if [ ! -e /etc/nginx/wedding-website-tls.conf ] && [ -f "$config" ]; then
        awk '
            /^[[:space:]]*ssl_certificate[[:space:]]+/ ||
            /^[[:space:]]*ssl_certificate_key[[:space:]]+/ { print }
        ' "$config" > "$migration"

        if [ "$(wc -l < "$migration")" -ne 2 ]; then
            echo '==> Could not migrate TLS paths automatically; using packaged defaults.'
            rm -f "$migration"
        fi
    fi

    # This static site replaces the former RSVP application. Stop it before
    # pacman removes its binary and unit, and remove its enabled-unit symlink.
    if systemctl is-active --quiet wedding-website-api.service 2>/dev/null ||
       systemctl is-enabled --quiet wedding-website-api.service 2>/dev/null; then
        echo '==> Stopping the retired wedding-website API.'
        systemctl disable --now wedding-website-api.service ||
            echo 'warning: could not fully stop or disable wedding-website-api.service'
    fi
}

post_upgrade() {
    migration=/run/wedding-website-tls.conf

    if [ -s "$migration" ]; then
        install -m644 "$migration" /etc/nginx/wedding-website-tls.conf
        rm -f "$migration"
        echo '==> Preserved the existing TLS certificate paths.'
    fi

    systemctl daemon-reload 2>/dev/null || true

    echo '==> Reload nginx to pick up the new build:'
    echo '      sudo systemctl reload nginx.service'

    if [ -f /etc/nginx/conf.d/wedding-website.conf.pacnew ]; then
        echo '==> Unexpected .pacnew found; merge it before reloading nginx:'
        echo '      sudo diff -u /etc/nginx/conf.d/wedding-website.conf{,.pacnew}'
        echo '      sudo nginx -t && sudo systemctl reload nginx.service'
    fi

    if [ -d /var/lib/wedding-website ]; then
        echo '==> Existing RSVP data remains in /var/lib/wedding-website.'
    fi
}
